[Unit]
Description=Kubernetes kubelet
Wants=network-online.target containerd.service
After=network-online.target containerd.service
# Starts only once cloud-config has handed the node its join material, so a
# fresh or recovery boot never registers a half-configured Node.
ConditionPathExists=|/etc/kubernetes/bootstrap-kubelet.conf
ConditionPathExists=|/var/lib/kubelet/kubeconfig

[Service]
EnvironmentFile=/etc/kubernetes/kubelet.env
ExecStart=/usr/bin/kubelet \
  --config=/var/lib/kubelet/config.yaml \
  --bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf \
  --kubeconfig=/var/lib/kubelet/kubeconfig \
  --container-runtime-endpoint=unix:///run/containerd/containerd.sock \
  --hostname-override=${NODE_NAME}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
